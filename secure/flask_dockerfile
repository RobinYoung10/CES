FROM python:3.12-slim

# Patch OS packages to reduce inherited CVEs (supply-chain hardening)
RUN apt-get update && apt-get -y upgrade && rm -rf /var/lib/apt/lists/*

RUN useradd -m appuser && mkdir -p /app/logs /app/data
WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools \
    && pip install --no-cache-dir -r requirements.txt \
    && rm -rf /usr/local/lib/python3.12/ensurepip
# ^ removes the bundled (unused) pip/setuptools wheels that carry stale CVEs

COPY templates /app/templates
COPY flask_app.py /app/app.py

RUN chown -R appuser:appuser /app
USER appuser

EXPOSE 5000
CMD ["gunicorn", "-b", "0.0.0.0:5000", "app:app"]
